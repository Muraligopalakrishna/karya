{
  "manifest_version": 3,
  "name": "Karya Browser Link",
  "version": "1.4.2",
  "description": "Lets your Karya agent (running on this PC) work in its own tabs of your Chrome. Sending, posting and submitting still need your approval in Karya.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Karya Browser Link",
    "default_popup": "popup.html"
  }
}
