# =====================  KARYA SETTINGS  =====================
# start.bat copies this file to .env on first run. Edit .env (not this file).
# Leave a value empty to disable that feature. Restart Karya after editing.

# ---------- AI brain (at least one; first one with a key is used, the rest are fallbacks) ----------
# FREE + recommended: Google Gemini key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# FREE backup: Groq key -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Any other OpenAI-compatible service (OpenAI, OpenRouter, ...). Fill all three to use it.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Offline brain on this PC (no key, slower). Uses Ollama; set OLLAMA_ENABLED=false to turn off.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=karya-qwen

# Optional: force provider order, e.g.  LLM_PROVIDERS=groq,gemini,ollama
LLM_PROVIDERS=

# ---------- Email (Gmail) ----------
# 1) Turn on 2-Step Verification  2) create an App Password at https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com

# ---------- Website deploys (Vercel) ----------
# Token from https://vercel.com/account/tokens (or run "npx vercel login" once instead)
VERCEL_TOKEN=

# ---------- Your files ----------
# Full path to your resume (PDF/DOCX). Leave empty and Karya can build one with you.
RESUME_PATH=
# Where Karya saves files it makes (default: the workspace folder next to this file)
WORKSPACE_DIR=

# ---------- Behaviour ----------
# ask  = Karya asks before risky actions (commands, file changes, sending, posting, applying)
# auto = only asks for critical ones (send email, post, submit/apply, pay, delete, deploy)
APPROVAL_MODE=ask
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=false
PORT=8765
