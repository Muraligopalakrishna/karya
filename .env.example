# Karya's settings. start.bat copies this file to .env on the first run.
# You don't need to edit anything here: Karya's Setup (top right of its page) saves all of it for you.
# If you do edit .env by hand, restart Karya afterwards. An empty value means "not set".

# ---------- AI (Karya needs at least one; the first that works is used, the rest are backups) ----------
# Paste any of these keys in Setup > AI and Karya works out which service it's from.
# Free keys: Gemini https://aistudio.google.com/apikey  Groq https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Also: OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY, DEEPSEEK_API_KEY, MISTRAL_API_KEY, XAI_API_KEY,
# TOGETHER_API_KEY, CEREBRAS_API_KEY, KIRO_API_KEY (each with a _MODEL setting next to it).

# Plans you already pay for, connected with a sign-in in Setup > AI (no key):
#   Kiro: KIRO_LOGIN=true                    (needs the Kiro CLI, https://kiro.dev/downloads)
#   Claude: CLAUDE_ENABLED=true, CLAUDE_MODEL=sonnet   (needs Claude Code, https://claude.com/claude-code)
#   ChatGPT: CODEX_ENABLED=true, CODEX_MODEL=gpt-5.4-mini   (needs the Codex CLI: npm install -g @openai/codex)

# Any other OpenAI-compatible service. Fill all three to use it.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Free AI on this PC (Ollama, no key, slow without a graphics card). Setup > AI downloads the model.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=karya-qwen

# Optional: the order to use them in, e.g. LLM_PROVIDERS=claude,groq,ollama
LLM_PROVIDERS=

# ---------- Email (Gmail) ----------
# Turn on 2-Step Verification, then make an App Password at https://myaccount.google.com/apppasswords
# Without these, Karya uses Gmail in its browser.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com

# ---------- Publishing websites (Vercel) ----------
# Token from https://vercel.com/account/tokens
VERCEL_TOKEN=

# ---------- Your files ----------
# Your resume (PDF or Word). The welcome guide sets it when you upload one.
RESUME_PATH=
# Where Karya saves the files it makes (default: the workspace folder next to this file)
WORKSPACE_DIR=

# ---------- How Karya works ----------
# ask  = Karya asks before commands and file changes too
# auto = Karya asks only before big actions (sending, posting, applying, paying, deleting, publishing)
APPROVAL_MODE=ask
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=false
PORT=8765
